# Copy this file to .env and replace every secret placeholder.

# Single source of truth for the Airflow base, package, label, and custom image tag.
AIRFLOW_VERSION=3.2.2

# Password for the Airflow PostgreSQL metadata database.
POSTGRES_PASSWORD=

# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Generate a 64-byte-or-stronger secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Password for the initial Airflow administrator account.
_AIRFLOW_WWW_USER_PASSWORD=

# JWT for a dedicated OpenMetadata ingestion bot. OpenLineage uses this to
# publish business-DAG runtime lineage to OpenMetadata.
OPENMETADATA_JWT_TOKEN=
OPENMETADATA_OPENLINEAGE_DISABLED=true
