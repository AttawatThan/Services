# PostgreSQL image version. Keep this on the latest tested 18.x patch release.
POSTGRES_VERSION=18.4

# Initial database and owner. POSTGRES_PASSWORD is required and must be changed.
POSTGRES_USER=dataplatform
POSTGRES_PASSWORD=
POSTGRES_DB=dataplatform

# Host port. Containers on dataplatform-metadata always use postgres-data:5432.
POSTGRES_PORT=5432
