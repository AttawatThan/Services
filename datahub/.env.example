# Copy this file to .env before running the Quick Start profile.
COMPOSE_PROFILES=quickstart

# DataHub image and UI ingestion CLI versions.
DATAHUB_VERSION=v1.7.0
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0

# Host ports exposed by Docker Compose.
DATAHUB_MAPPED_FRONTEND_PORT=9002
DATAHUB_MAPPED_GMS_PORT=8080
DATAHUB_MAPPED_GMS_MANAGEMENT_PORT=4319
DATAHUB_MAPPED_KAFKA_PORT=9092
DATAHUB_MAPPED_POSTGRES_PORT=5432
DATAHUB_MAPPED_ELASTIC_PORT=9200
DATAHUB_ELASTIC_PORT=9200

# PostgreSQL primary storage. Kafka remains the messaging transport.
DATAHUB_POSTGRES_IMAGE=acryldata/datahub-postgres
DATAHUB_POSTGRES_VERSION=17.5-extensions-v1
POSTGRES_DB=datahub
POSTGRES_USER=datahub
# Quick Start falls back to datahub when this is empty. Set a strong password
# before using this configuration outside a local development machine.
POSTGRES_PASSWORD=

# Stable resource names. Override these to run an isolated stack.
DATAHUB_NETWORK_NAME=datahub_network
DATAHUB_BROKER_VOLUME_NAME=datahub_broker
DATAHUB_POSTGRES_VOLUME_NAME=datahub_postgresdata
DATAHUB_OPENSEARCH_VOLUME_NAME=datahub_osdata

# Quick Start defaults to JohnSnowKnowsNothing when this is empty. Replace it
# only after updating every DataHub component to use the same value.
DATAHUB_SYSTEM_CLIENT_SECRET=

# Required token-service secrets. Generate separate values with:
# openssl rand -hex 32
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=
DATAHUB_TOKEN_SERVICE_SALT=
